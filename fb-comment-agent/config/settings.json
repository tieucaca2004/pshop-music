{
  "agent": {
    "name": "Facebook Comment AI Agent - Á Tiểu Nhị",
    "version": "1.0.0",
    "checkIntervalMinutes": 15,
    "confidenceThreshold": 0.8,
    "maxReplyLength": 2000,
    "language": "vi",
    "autoReplyEnabled": true
  },
  "facebook": {
    "pageId": "109215528208008",
    "pageUrl": "https://www.facebook.com/109215528208008",
    "apiVersion": "v19.0"
  },
  "logging": {
    "logLevel": "info",
    "logToFile": true,
    "maxLogEntries": 10000,
    "keepDays": 30
