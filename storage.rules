rules_version = '2';

// Firebase Storage Security Rules — Multi-Tenant (Phase 1, Task 5.0)
//
// Tenant paths under /businesses/{businessId}/ are isolated per-tenant.
// Legacy paths at root retain the original behavior for backward compatibility.
//
// NOTE: Storage Rules cannot cross-reference Realtime Database;
// tenant identity uses Firebase Auth custom claims:
//   request.auth.token.businessId — matches /businesses/{businessId}/ prefix
//   request.auth.token.roles.super_admin — platform-wide access
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Tenant-Isolated Paths ───
    // Each business stores assets under /businesses/{businessId}/
    // Access: businessId-matched users + super admins
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
      allow write: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
    }

    // ─── Legacy Paths (backward compatible) ───
    // Existing PSH content at root — unchanged behavior.
    // GET: public (existing pages reference URLs directly)
    // LIST: authenticated only (media library)
    // WRITE: authenticated only (CMS uploads)
    match /{allPaths=**} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
