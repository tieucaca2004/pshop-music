rules_version = '2';

// Firebase Storage Security Rules — Multi-Tenant (Phase 1, Task 6.1)
//
// FIXED: Legacy catch-all no longer overrides tenant isolation.
// The catch-all write rule includes a condition that explicitly excludes
// /businesses/{businessId}/ paths, preventing cross-tenant access.
//
// Super Admin bypass: `request.auth.token.roles.super_admin == true`
//   This is set via Firebase Auth custom claims by POST /v1/users/custom-claims.
//   Super admins have platform-wide read/write access to ALL storage paths,
//   including all tenant paths under /businesses/{businessId}/.
//   This is INTENTIONAL — super admins manage the platform infrastructure.
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Tenant-Isolated Paths ───
    // Each business stores assets under /businesses/{businessId}/
    // Access: businessId-matched users + super admins
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
      allow write: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
    }

    // ─── Legacy Paths (backward compatible) ───
    // Existing PSH content at root — unchanged read/list behavior.
    // WRITE: authenticated only, EXCLUDES /businesses/ paths.
    // The `!resource.name.matches("^businesses/")` condition prevents
    // this catch-all from overriding the tenant isolation above.
    match /{allPaths=**} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null
        && !resource.name.matches("^businesses/");
    }
  }
}