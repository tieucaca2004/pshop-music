rules_version = '2';

// Firebase Storage Security Rules - Multi-Tenant (Phase 1, Task 6.1)
//
// Legacy catch-all no longer overrides tenant isolation for EITHER read or
// write. The write rule already excluded /businesses/{businessId}/ paths;
// the read rule (`allow get: if true`) did NOT, so it independently and
// unconditionally granted read access to every tenant's files to anyone,
// including fully unauthenticated requests -- Security Rules OR multiple
// matching blocks together, so an unrestricted catch-all always wins
// regardless of a more specific rule elsewhere. Found live (Task 2.6,
// Customer Workspace Media Library validation): confirmed cross-tenant AND
// unauthenticated reads of tenant media both succeeded before this fix.
// Now both get and list exclude /businesses/ paths, matching write exactly.
//
// Super Admin bypass: `request.auth.token.roles.super_admin == true`
//   This is set via Firebase Auth custom claims by POST /v1/users/custom-claims.
//   Super admins have platform-wide read/write access to ALL storage paths,
//   including all tenant paths under /businesses/{businessId}/.
//   This is INTENTIONAL - super admins manage the platform infrastructure.
//
// ASCII-ONLY: this file is routinely copy-pasted into the Firebase Console
// Rules editor by the Chief Architect (rules deploys are manual). Non-ASCII
// characters (em dashes, box-drawing characters, Vietnamese text) survived
// in comments here previously and came through the clipboard mangled,
// producing "token recognition error" on publish. Keep every character in
// this file plain ASCII.
service firebase.storage {
  match /b/{bucket}/o {

    // --- Root prefix listing ---
    // MediaLibrary.list() (js/media-library.js) walks the bucket from the
    // ROOT for legacy/pshop-music CMS sessions, because existing images
    // predate per-tenant folders and live scattered at products/, banners/,
    // sliders/, category-tiles/, blog/, uploads/.
    //
    // The catch-all `match /{allPaths=**}` block below does NOT reliably
    // cover a root listing (there is no path segment for allPaths to bind),
    // so a root listAll() fell through to deny-by-default and the whole
    // Media Library failed with storage/unauthorized on path "" - breaking
    // every "CHON ANH" picker across the CMS (Category/Product/Banner/
    // Slider/Blog), reported live by the Founder.
    //
    // Listing a prefix only returns names, never file contents; per-object
    // reads still go through the get/read rules below, and the recursive
    // walk skips the businesses/ subtree client-side, so tenant isolation
    // is unchanged.
    allow list: if request.auth != null;

    // --- Tenant-Isolated Paths ---
    // Each business stores assets under /businesses/{businessId}/
    // Access: businessId-matched users + super admins
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
      allow write: if request.auth != null
        && (request.auth.token.businessId == businessId
            || request.auth.token.roles.super_admin == true);
    }

    // --- Legacy Paths (backward compatible) ---
    // Existing PSH content at root - unchanged read/list behavior.
    // GET/LIST/WRITE: all EXCLUDE /businesses/ paths, so this catch-all
    // never overrides the tenant-isolated block above in either direction.
    match /{allPaths=**} {
      // list has no single existing "resource" (it enumerates a prefix), so
      // it must check the requested path itself (allPaths, this match's own
      // capture) rather than resource.name -- get/write operate on one real
      // object each and can use resource.name directly, matching the
      // tenant-isolated block's own convention.
      //
      // .matches() requires a FULL match of the entire string, not a prefix
      // match -- "^businesses/" alone (no trailing .*) never actually
      // matched a real object path like "businesses/x/media/f.txt", so this
      // condition was always true and get/write silently stayed open to
      // businesses/ paths.
      //
      // WRITE FIX (Founder-reported live 2026-08-13, storage/unauthorized on
      // new uploads e.g. media/*.jpg): the old write rule referenced
      // `resource.name`, but `resource` is null when creating a BRAND-NEW
      // file, so EVERY new upload evaluated to deny -> storage/unauthorized
      // for the whole legacy tree (Media Library upload broke).
      // Use the match capture `allPaths[0]` (same convention as the list
      // rule) which is available for both new and existing objects, instead
      // of resource.name which is null on create.
      //
      // LIST FIX (2026-08-14): the guard was `!(allPaths.size() > 0 &&
      // allPaths[0] == 'businesses')`, but `allPaths` is a PATH and the
      // Firebase Rules compiler rejects `.size()` on it ("Invalid type.
      // Received one of [path]. Expected one of [string, bytes, list, set,
      // map]") -- an errored condition evaluates to false, so every
      // authenticated listAll() was denied. Verified against the real Rules
      // compiler: `.size()` warns, `allPaths[0]` compiles CLEAN. Dropping
      // only `.size()` keeps the SAME tenant guard: allPaths[0] is
      // 'businesses' for both `businesses` and `businesses/<id>/...`, so
      // tenant listing stays denied. Root listing ("" -> no segment to bind)
      // is still granted by the bucket-level `allow list` above.
      allow get: if !resource.name.matches("^businesses/.*");
      allow list: if request.auth != null
        && allPaths[0] != 'businesses';
      allow write: if request.auth != null
        && !(allPaths.size() > 0 && allPaths[0] == 'businesses');
    }
  }
}
